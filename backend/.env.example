# 王者万象棋数据站 · 环境变量样例（复制为 backend/.env 后填写；.env 已被 gitignore，禁止提交真实密钥）

# 运行模式：formal=正式(PostgreSQL 唯一权威) / demo=演示(本地文件引擎)
WXQ_APP_MODE=formal

# PostgreSQL 连接（formal 模式 PGDATABASE/PGUSER 必填）
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=wanxiangqi
PGUSER=lhw
# PGPASSWORD=（本地 trust 认证可留空；如有密码请注入环境，勿写入仓库）

# 管理写接口 Bearer 令牌（formal 模式必填，无默认值；请生成随机长串）
ADMIN_TOKEN=change-me-to-a-long-random-string

# HTTP 监听（默认 127.0.0.1:8080，仅本机访问）
# HOST=127.0.0.1
# PORT=8080

# 小样本阈值（统计样本数低于该值标记 isSmallSample，默认 20）
# WXQ_SMALL_SAMPLE_THRESHOLD=20

# demo 模式文件存储目录（默认 tools/emulator-watcher/data；测试注入临时目录）
# WXQ_DATA_DIR=

# datatft 平台同步总开关（默认关闭；未核实 API 契约与授权前保持 0）
# WXQ_ENABLE_DATATFT=0

# datatft 适配器签名密钥（原 SIGN_SECRET 硬编码已移除；仅开启同步时需要）
# WXQ_DATATFT_SIGN_SECRET=

# 材料原件上传大小上限（字节；正式模式默认 10MB。demo 文件引擎固定 1MB 不受此值影响）
# WXQ_MAX_UPLOAD_BYTES=10485760
